# ===========================================
# 환경 변수 예시 파일 (.env.example)
# 사용법: 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요.
# 이 파일은 깃허브에 올라갑니다. 값은 절대 적지 마세요!
# ===========================================

# 카카오 REST API 키
KAKAO_REST_API_KEY=

# 카카오 JavaScript 키
KAKAO_JAVASCRIPT_KEY=

# 카카오 Client Secret
KAKAO_CLIENT_SECRET=

# 카카오 로그인 후 돌아올 주소 (Redirect URI)
KAKAO_REDIRECT_URI=

# 로그인 상태(세션) 암호화용 비밀 문자열
SESSION_SECRET=

# 뉴스 API 키 (newsapi.org)
NEWS__API_KEY=

# 날씨 API 키 (openweathermap.org)
weather_API_KEY=

# OpenAI API 키 (platform.openai.com)
# ※ OPENAI_API_KEY라는 이름은 Netlify AI Gateway가 덮어쓰므로 쓰지 마세요
GPT_API_KEY=

# 사용할 GPT 모델 (비워두면 gpt-6-luna)
GPT_MODEL=

# 영화 정보 API 키 (themoviedb.org)
TMDB_API_KEY=
