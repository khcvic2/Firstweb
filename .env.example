# ===========================================
# 환경 변수 예시 파일 (.env.example)
# 사용법: 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요.
# 이 파일은 깃허브에 올라갑니다. 실제 비밀 정보는 절대 적지 마세요!
# 값은 카카오 개발자 사이트(developers.kakao.com) > 내 애플리케이션에서 확인하세요.
# ===========================================

# REST API 키 (앱 키 메뉴)
KAKAO_REST_API_KEY=

# JavaScript 키 (앱 키 메뉴) - 웹페이지에서 카카오 SDK를 쓸 때 필요
KAKAO_JAVASCRIPT_KEY=

# Client Secret (보안 메뉴) - 사용 설정을 켰을 때만 필요
KAKAO_CLIENT_SECRET=

# Redirect URI (카카오 로그인 메뉴에 등록한 주소와 똑같이 입력)
# Netlify 배포 주소 - "사이트이름" 부분을 Netlify에서 정한 이름으로 바꾸세요
KAKAO_REDIRECT_URI=https://사이트이름.netlify.app/auth/kakao/callback
# 내 컴퓨터에서 테스트할 때는 위 줄 앞에 #을 붙이고, 아래 줄의 #을 지워서 사용
# KAKAO_REDIRECT_URI=http://localhost:8888/auth/kakao/callback

# 로그인 상태(세션)를 암호화할 때 쓰는 비밀 문자열 - 아무도 모르는 긴 문자열로 직접 정하기
SESSION_SECRET=
